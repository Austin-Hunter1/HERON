{
  "_comment": "Settings of the herongnss.org build (website/build_site.py). Paths are relative to the repository root.",
  "domain": "herongnss.org",
  "out_dir": "website/_site",
  "pages_src": "website/src",
  "images": "website/images.json",
  "course_build": "docs/teaching/build.py",
  "planner": {
    "_comment": "The /sim/ page: Jack Abrams' mission planner (D-120). git_ref is where the planner code comes from; set it to main once mission-planner-v2 is merged. Jack approved publishing (D-122).",
    "git_ref": "origin/mission-planner-v2",
    "approved_by_author": true,
    "title": "HERON mission planner · web demo",
    "dir": "website/planner",
    "cache_dir": "website/_cache",
    "requirements": "website/planner/requirements-pyodide.txt",
    "dep_packages": [
      "flask",
      "werkzeug",
      "itsdangerous",
      "click",
      "blinker",
      "sgp4",
      "tzdata"
    ],
    "pyodide_url": "https://cdn.jsdelivr.net/pyodide/v0.29.5/full/",
    "packages": [
      "numpy",
      "shapely",
      "jinja2",
      "markupsafe",
      "ssl"
    ]
  },
  "nav": {
    "_comment": "The menu (☰) on the course and planner pages, which keep their own layout. key matches the page; path is from the site root.",
    "script": "website/nav/site_nav.js",
    "logo": "img/heron-logo.png",
    "links": [
      {
        "key": "home",
        "label": "Home",
        "path": ""
      },
      {
        "key": "about",
        "label": "About HERON",
        "path": "about/"
      },
      {
        "key": "publications",
        "label": "Publications + results",
        "path": "publications/"
      },
      {
        "key": "course",
        "label": "GNSS signal course",
        "path": "course/"
      },
      {
        "key": "sim",
        "label": "Mission planner demo",
        "path": "sim/"
      }
    ]
  },
  "katex_dir": "docs/teaching/src/vendor/katex"
}

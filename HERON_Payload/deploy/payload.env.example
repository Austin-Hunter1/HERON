# /etc/heron/payload.env
# USB-UART adapter wired to the Cube's TELEM2. Use the stable by-id path: ls -l /dev/serial/by-id/
HERON_CUBE_PORT=/dev/serial/by-id/REPLACE_ME
# Must match SERIAL2_BAUD on the Cube (921 = 921600)
HERON_CUBE_BAUD=921600
# The aircraft's MAVLink system id (SYSID_THISMAV), normally 1
HERON_SYSTEM_ID=1
# Payload Setup web app. 0.0.0.0:8080 = reachable on the Ethernet cable at http://heron-nuc.local:8080
HERON_SETUP_HTTP=0.0.0.0:8080
